<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="sqlport"
        Arguments=""
        InstallLocation="C:\Program Files\sqlport\sqlport">
    </Installer>
    <PackageInformation
        PackageName="sqlport"
        PackageDisplayName="sqlport"
        PublisherName="CN=sqlport"
        PublisherDisplayName="sqlport"
        Version="0.1.0.0"
        PackageDescription="Cross-platform database management tool">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.sqlport.app"
                Description="Cross-platform database management tool"
                DisplayName="sqlport"
                ExecutableName="sqlport"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>sqlport</DisplayName>
            <PublisherDisplayName>sqlport</PublisherDisplayName>
            <Description>Cross-platform database management tool</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="sqlport.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
